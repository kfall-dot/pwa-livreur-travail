# Frontend — chemins API relatifs (/api/v1 → netlify functions en prod / netlify:dev)
# Obligatoire au build Netlify (voir netlify.toml [build.environment])
VITE_API_URL=/api/v1
VITE_API_BACKEND=livraison
# Dev quotidien (sans CLI Netlify) : npm run dev:local → http://localhost:5173
# Dev + Functions/Blobs : npm run netlify:dev → http://localhost:8888
# Cible du proxy Vite — auto :8888 sous netlify:dev, sinon Express :3002
# VITE_API_PROXY_TARGET=http://localhost:3002

# Backend (Express — npm run dev:local / dev:server)
PORT=3002
# URL Postgres pour le mode local (Neon ou Postgres maison). Obligatoire hors netlify:dev.
# NETLIFY_DB_URL=postgresql://user:pass@….neon.tech/neondb?sslmode=require
# Lien certificats / e-mails en local
# PUBLIC_BASE_URL=http://localhost:5173
# Obligatoire en production (min. 32 caractères aléatoires). Ex. openssl rand -base64 48
JWT_SECRET=change-me-in-production
# Dev uniquement — interdit en production (NODE_ENV=production)
DRIVER_PIN=1234
MANAGER_PASSWORD=admin1234
OTP_CODE=123456
GEOFENCE_BYPASS=false
ALLOW_RESET=false
ALLOW_SEED=false
# E2E / CI : branche Postgres Netlify « e2e » (pas production).
# Provision : git checkout e2e && npx netlify deploy --context branch:e2e
# Puis : npx netlify database status --branch e2e --show-credentials
# Copier dans .env.e2e.local (voir docs/SECURITY-OPS.md §4) — ne jamais commiter l’URL.
# E2E_DATABASE_URL=postgresql://…
# Empreinte hostname prod (auto) : npm run db:fingerprint -- "$NETLIFY_DB_URL"
# PRODUCTION_DB_FINGERPRINT=16950163f70780b3
# E2E seulement : effacer aussi livreurs/managers au reset (refusé sur base pilote)
# ALLOW_WIPE_USERS=true
# Pilote : si un seed recrée Aya / Kouassi / manager après wipe, utiliser ces valeurs
# SEED_DRIVER2_PHONE=+2250700430402
# SEED_DRIVER_PHONE=+2250701234567
# SEED_MANAGER_EMAIL=kfallet@gmail.com

# QR sales deck : entrée démo sans login (co-demo uniquement). Activé en prod via netlify.toml.
# PUBLIC_DEMO_ENABLED=true : autoriser POST /auth/register-company en production
# ALLOW_SELF_SIGNUP=true
# Obligatoire pour reset/seed automatisés (E2E, scripts). Header X-Admin-Token.
# En prod avec ALLOW_RESET/SEED : définir un secret fort, ou se connecter en manager.
# ADMIN_API_TOKEN=
# Reset admin : POST /api/admin/reset avec { "confirm": "SUPPRIMER TOUTES LES DONNÉES" }
# + auth (X-Admin-Token ou cookie manager)

# E-mail — bon de livraison après confirmation OTP
# mock = logs console (défaut dev / E2E). smtp = nodemailer (Brevo, Mailpit, Resend…)
EMAIL_PROVIDER=mock
EMAIL_FROM=livraisons@ferme-dupont.fr
PUBLIC_BASE_URL=http://localhost:8888
# Production : origines CORS supplémentaires (previews Netlify), séparées par des virgules
# CORS_ORIGINS=https://preview-xxx.netlify.app

# --- Option A : Mailpit (local, remplace Mailtrap en dev) ---
# docker run -d -p 8025:8025 -p 1025:1025 axllent/mailpit
# Interface : http://localhost:8025
# EMAIL_PROVIDER=smtp
# SMTP_HOST=localhost
# SMTP_PORT=1025
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=

# --- Option B : Brevo (pilote / prod — 300 e-mails/jour gratuits) ---
# Compte : https://www.brevo.com → Paramètres → SMTP & API → Clé SMTP
# Vérifier le domaine (SPF/DKIM) pour EMAIL_FROM.
# EMAIL_PROVIDER=smtp
# SMTP_HOST=smtp-relay.brevo.com
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=ton-login-brevo
# SMTP_PASS=ta-cle-smtp-brevo
# EMAIL_FROM=livraisons@ton-domaine.com

# SMS OTP — envoyé au téléphone responsable du point (+225)
# mock = logs console (défaut dev / E2E). textbee = Android+SIM CI. twilio = prod.
SMS_PROVIDER=mock
OTP_CODE=123456
SMS_OTP_FAIL_OPEN=true

# --- Module BTP Achats-Chantier (WhatsApp → EB → approbations → livraison) ---
# WHATSAPP_MOCK=true
# WHATSAPP_VERIFY_TOKEN=traceo-dev-verify
# WHATSAPP_DEFAULT_COMPANY_ID=co-btp-pilote
# PROCUREMENT_BT_THRESHOLD_FCFA=1000000
# BTP_SEED=true
# OPENAI_API_KEY=   # optionnel — extraction IA multimodale

# --- Option A : Textbee (pilote CI — Android + SIM Orange/MTN/Moov) ---
# https://textbee.dev — app Android + clé API
# SMS_PROVIDER=textbee
# TEXTBEE_API_KEY=
# TEXTBEE_DEVICE_ID=
# TEXTBEE_API_BASE=https://api.textbee.dev/api/v1
# SMS_OTP_FAIL_OPEN=false
# OTP_CODE=   # laisser vide en prod pour code aléatoire

# --- Option B : Twilio (prod internationale) ---
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMBER=+225XXXXXXXX
# SMS_OTP_FAIL_OPEN=false

# Contournements tests — voir VALIDATIONS-TESTS.md et config/validations-tests.env
# VITE_GEOFENCE_BYPASS=true
# VITE_PHOTOS_BYPASS=true

# ─── BTP Achats-Chantier (procurement) ───────────────────────────────────────
# Seuil BT en FCFA (DAF si < seuil, circuit BT+PDG si ≥ seuil). Défaut : 1 000 000
# PROCUREMENT_BT_THRESHOLD_FCFA=1000000
# Webhook Meta WhatsApp Business
# WHATSAPP_VERIFY_TOKEN=traceo-dev-verify
# WHATSAPP_MOCK=true
# WHATSAPP_DEFAULT_COMPANY_ID=co-btp-pilote
# OPENAI_API_KEY=   # parsing EB vocal/image (optionnel)
# OPENAI_EB_MODEL=gpt-4o-mini
# Comptes pilote BTP (seed)
# BTP_DT_EMAIL=dt@btp-pilote.ci
# BTP_DAF_EMAIL=daf@btp-pilote.ci
# BTP_SA_EMAIL=sa@btp-pilote.ci
# BTP_PDG_EMAIL=pdg@btp-pilote.ci
# BTP_CDG_EMAIL=cdg@btp-pilote.ci
# BTP_DRIVER_PHONE=+2250700998877
