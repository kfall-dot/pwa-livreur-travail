{
  "name": "pwa-livreur-api",
  "main": "dist-server/server/worker.js",
  "workers_dev": true,
  "compatibility_date": "2024-09-23",
  "compatibility_flags": ["nodejs_compat"],
  "build": {
    "command": "npm run build:server && test -f dist-server/server/worker.js"
  },

  "routes": [
    { "pattern": "livreur.cf-ops.net/api/*",          "zone_name": "cf-ops.net" },
    { "pattern": "livreur.cf-ops.net/.well-known/*", "zone_name": "cf-ops.net" }
  ],

  "triggers": { "crons": ["*/5 * * * *"] },

  "vars": {
    "MAX_EXECUTION_MS": 30000,
    "PUBLIC_BASE_URL": "https://livreur.cf-ops.net",
    "GEOFENCE_BYPASS": "false",
    "SMS_OTP_FAIL_OPEN": "false",
    "VITE_API_URL": "/api/v1"
  }

}
