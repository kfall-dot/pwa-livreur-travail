# ═══════════════════════════════════════════════════════════════════════════
# Pilote Netlify — pwa-livreur.netlify.app
# ═══════════════════════════════════════════════════════════════════════════
# Copiez chaque ligne dans : Netlify → Site configuration → Environment variables
# Scope : Production (et Deploy previews si vous testez sur les previews)
# Après modification : Deploys → Trigger deploy → Deploy site
#
# Guide détaillé : docs/CONFIGURATION-PILOTE.md
# ═══════════════════════════════════════════════════════════════════════════

# ─── Obligatoire (sécurité + base) ──────────────────────────────────────────
# Générer : openssl rand -base64 48
JWT_SECRET=

# Netlify Database → branche production → Copy connection string (lecture/écriture)
# Ne jamais committer cette valeur.
NETLIFY_DB_URL=

# URL publique du site (liens certificat dans les e-mails)
PUBLIC_BASE_URL=https://pwa-livreur.netlify.app

# ─── E-mail — bon de livraison (après confirmation OTP) ─────────────────────
# Destinataire = e-mail du compte MANAGER en base (pas le contact du point)
EMAIL_PROVIDER=smtp
EMAIL_FROM=livraisons@votre-domaine.com

# Brevo : https://www.brevo.com → Paramètres → SMTP & API
SMTP_HOST=smtp-relay.brevo.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=

# ─── SMS OTP — envoyé au téléphone RESPONSABLE de l'arrêt ─────────────────
# Pas au livreur sauf si c'est le même numéro sur l'arrêt
SMS_PROVIDER=textbee

# Textbee : https://textbee.dev — app Android + SIM CI
TEXTBEE_API_KEY=
TEXTBEE_DEVICE_ID=
TEXTBEE_API_BASE=https://api.textbee.dev/api/v1

# En prod pilote : false (le responsable doit recevoir le SMS)
SMS_OTP_FAIL_OPEN=false

# NE PAS définir OTP_CODE en production (code aléatoire à 6 chiffres)

# ─── Alternative SMS : Twilio (décommenter et remplir si pas Textbee) ───────
# SMS_PROVIDER=twilio
# TWILIO_SID=
# TWILIO_TOKEN=
# TWILIO_NUMBER=+225XXXXXXXX

# ─── Déjà présent sur le site ───────────────────────────────────────────────
NODE_VERSION=20

# ─── Identité pilote (figée — un seed ne doit pas la perdre) ─────────────────
SEED_DRIVER2_PHONE=+2250700430402
SEED_MANAGER_EMAIL=kfallet@gmail.com

# Self-service création d’entreprise (sinon onboarding manuel)
# ALLOW_SELF_SIGNUP=true

# Observabilité (recommandé production)
# Client (PWA) — public, injecté au build Vite
# VITE_SENTRY_DSN=https://...@....ingest.sentry.io/...
# API (Functions) — secret runtime
# SENTRY_DSN=https://...@....ingest.sentry.io/...
# Source maps (build Netlify uniquement — secrets, pas en repo)
# SENTRY_AUTH_TOKEN=
# SENTRY_ORG=
# SENTRY_PROJECT=

# ─── NE PAS activer en production pilote ────────────────────────────────────
# SMS_PROVIDER=mock
# OTP_CODE=123456
# DRIVER_PIN=1234
# GEOFENCE_BYPASS=true
# ALLOW_RESET=true
# ALLOW_SEED=true
# Si ALLOW_RESET/SEED exceptionnellement : ADMIN_API_TOKEN=<secret fort> + auth X-Admin-Token
