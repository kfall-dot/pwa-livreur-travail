# =============================================================================
# Validations mises de côté pour les tests — NE PAS utiliser en production
# =============================================================================
# Copier les lignes souhaitées dans .env.development (PWA) et/ou relancer
# l'API Livraison avec ces variables (docker compose).
# Documentation détaillée : VALIDATIONS-TESTS.md
# =============================================================================

# --- PWA Livreur (frontend Vite) ---
# Contourne le géofencing côté navigateur (200 m / 100 m)
VITE_GEOFENCE_BYPASS=true

# Une seule photo suffit (au lieu d'une par unité)
VITE_PHOTOS_BYPASS=true

# Mode Playwright : GPS simulé + bouton « Simuler photo »
# VITE_E2E=true

# --- API mock Express (server/, port 3002) ---
GEOFENCE_BYPASS=true
OTP_CODE=123456
# ALLOW_RESET=true

# --- E-mail (tests E2E / regression — évite SMTP cloud type Mailtrap) ---
EMAIL_PROVIDER=mock

# --- SMS OTP (tests E2E / regression — pas d’envoi réel) ---
SMS_PROVIDER=mock
SMS_OTP_FAIL_OPEN=true

# --- API Livraison réelle (Docker livraison-api, port 3001) ---
# Relancer après changement : docker compose up -d --build api
GEOFENCE_DISABLED=true
PHOTOS_MIN_ONLY=true
SMS_OTP_FAIL_OPEN=true
# GEOFENCE_RADIUS_M=5000
